PORT=3000
DB_PATH=./data/evflow.db
# REQUIRED in production: long random string  (node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_TTL=30d
# Your frontend's URL (comma-separated for several). "*" is fine for local dev only.
CORS_ORIGIN=*
# dev = OTP is returned in the API response and logged (no SMS needed). sms = send via Twilio.
OTP_MODE=dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Seeds the Thapar demo site and enables POST /api/auth/demo
DEMO_MODE=true
DEFAULT_TZ_OFFSET_MIN=330
